                <reportElement x="420" y="50" width="130" height="18" forecolor="#BDC3C7"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["By: " + $P{GENERATED_BY}]]></textFieldExpression>
            </textField>

            <!-- Report ID -->
            <textField isBlankWhenNull="true">
                <reportElement x="420" y="73" width="130" height="15" forecolor="#95A5A6"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="8"/>
                </textElement>
