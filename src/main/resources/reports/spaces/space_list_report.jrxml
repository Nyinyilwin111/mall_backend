    <parameter name="GENERATED_BY" class="java.lang.String" isForPrompting="false">
        <defaultValueExpression><![CDATA["System Administrator"]]></defaultValueExpression>
    </parameter>
    <parameter name="REPORT_ID" class="java.lang.String" isForPrompting="false">
        <defaultValueExpression><![CDATA["SPACE-LIST-2025"]]></defaultValueExpression>
    </parameter>
    <parameter name="status" class="java.lang.String"/>
    <parameter name="spaceTypeId" class="java.lang.String"/>
    <parameter name="branchId" class="java.lang.String"/>
    <parameter name="spaceType" class="java.lang.String"/>
    <parameter name="branch" class="java.lang.String"/>
    <parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
        <defaultValueExpression><![CDATA[""]]></defaultValueExpression>
    </parameter>

    <!-- Fixed SQL Query based on entity relationships -->
    <queryString>
        <![CDATA[
SELECT
    s.space_id,
    s.space_code,
    s.location,
    s.size_sqft,
    s.price,
    s.status,
    s.amenities,
    -- Get images from space_images table (not from Images entity)
    COALESCE(
        (SELECT GROUP_CONCAT(si.image_url SEPARATOR ', ')
         FROM space_images si
         WHERE si.space_id = s.space_id),
        'No images'
    ) as images,
    st.type_name as space_type_name,
    f.level as floor_level,
    b.name as branch_name,
    b.id as branch_id,
    st.space_type_id,
    -- Image count from space_images table
    (SELECT COUNT(*) FROM space_images si WHERE si.space_id = s.space_id) as image_count
FROM space s
LEFT JOIN spacetype st ON s.space_type_id = st.space_type_id
LEFT JOIN floor f ON s.Floor_floor_id = f.floor_id
LEFT JOIN branches b ON f.branch_branch_id = b.id
WHERE 1=1
    AND ($P{status} IS NULL OR $P{status} = '' OR s.status = $P{status})
    AND ($P{spaceTypeId} IS NULL OR $P{spaceTypeId} = '' OR st.space_type_id = UUID_TO_BIN($P{spaceTypeId}))
    AND ($P{branchId} IS NULL OR $P{branchId} = '' OR b.id = CAST($P{branchId} AS UNSIGNED))
    AND ($P{spaceType} IS NULL OR $P{spaceType} = '' OR st.type_name LIKE CONCAT('%', $P{spaceType}, '%'))
    AND ($P{branch} IS NULL OR $P{branch} = '' OR b.name LIKE CONCAT('%', $P{branch}, '%'))
ORDER BY b.name, f.level, s.space_code
        ]]>
    </queryString>

    <!-- Fields - Fixed based on query results -->
    <field name="space_id" class="java.lang.String"/>
    <field name="space_code" class="java.lang.String"/>
    <field name="location" class="java.lang.String"/>
    <field name="size_sqft" class="java.lang.Double"/>
    <field name="price" class="java.lang.Double"/>
    <field name="status" class="java.lang.String"/>
    <field name="amenities" class="java.lang.String"/>
    <field name="images" class="java.lang.String"/>
    <field name="space_type_name" class="java.lang.String"/>
    <field name="floor_level" class="java.lang.String"/>
    <field name="branch_name" class="java.lang.String"/>
    <field name="branch_id" class="java.lang.Long"/>
    <field name="space_type_id" class="java.lang.String"/>
    <field name="image_count" class="java.lang.Integer"/>

    <!-- Variables -->
    <variable name="imageCount" class="java.lang.Integer" calculation="Count">
        <variableExpression><![CDATA[$F{images} != null && !$F{images}.equals("No images") ? 1 : 0]]></variableExpression>
    </variable>

    <variable name="totalSpaces" class="java.lang.Integer" calculation="Count">
        <variableExpression><![CDATA[$F{space_id}]]></variableExpression>
    </variable>

    <variable name="totalSize" class="java.lang.Double" calculation="Sum">
        <variableExpression><![CDATA[$F{size_sqft} != null ? $F{size_sqft} : 0]]></variableExpression>
    </variable>

    <variable name="totalValue" class="java.lang.Double" calculation="Sum">
        <variableExpression><![CDATA[$F{price} != null ? $F{price} : 0]]></variableExpression>
    </variable>

    <!-- Title Band -->
    <title>
        <band height="150" splitType="Stretch">
            <!-- Header Background -->
            <rectangle radius="8">
                <reportElement x="0" y="0" width="555" height="120" backcolor="#2C3E50"/>
                <graphicElement>
                    <pen lineWidth="0.0" lineColor="#2C3E50"/>
                </graphicElement>
            </rectangle>

            <!-- Logo -->
            <image scaleImage="RetainShape" onErrorType="Blank">
                <reportElement x="20" y="25" width="60" height="60"/>
                <imageExpression><![CDATA[$P{COMPANY_LOGO}]]></imageExpression>
            </image>

            <!-- Company Name -->
            <textField isBlankWhenNull="true">
                <reportElement x="100" y="25" width="300" height="25" forecolor="#FFFFFF"/>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="16" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{COMPANY_NAME}]]></textFieldExpression>
            </textField>

            <!-- Report Title -->
            <textField isBlankWhenNull="true">
                <reportElement x="100" y="55" width="300" height="20" forecolor="#ECF0F1"/>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="12"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{REPORT_TITLE}]]></textFieldExpression>
            </textField>

            <!-- Filter Info -->
            <textField isBlankWhenNull="true">
                <reportElement x="100" y="80" width="300" height="30" forecolor="#BDC3C7"/>
                <textElement textAlignment="Left" verticalAlignment="Top">
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[
                    "Filters: " +
                    ($P{status} != null && !$P{status}.isEmpty() ? "Status=" + $P{status} + ", " : "") +
                    ($P{spaceType} != null && !$P{spaceType}.isEmpty() ? "Type=" + $P{spaceType} + ", " : "") +
                    ($P{branch} != null && !$P{branch}.isEmpty() ? "Branch=" + $P{branch} : "")
                ]]></textFieldExpression>
            </textField>

            <!-- Date -->
            <textField pattern="EEE, MMM dd, yyyy">
                <reportElement x="420" y="25" width="130" height="20" forecolor="#ECF0F1"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{REPORT_DATE}]]></textFieldExpression>
            </textField>

            <!-- Generated by -->
