                </textElement>
                <textFieldExpression><![CDATA[
                    ($P{spaceCode} == null ? "All Spaces" : "Space: " + $P{spaceCode}) +
                    " | " +
                    ($P{branchId} == null ? "All Branches" : "Branch ID: " + $P{branchId})
                ]]></textFieldExpression>
            </textField>
        </band>
    </title>

