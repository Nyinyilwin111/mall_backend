                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="14" isBold="false"/>
                </textElement>
                <textFieldExpression><![CDATA["Space Income Report - " + $P{periodType}]]></textFieldExpression>
            </textField>

            <!-- Date Range Badge -->
            <textField isBlankWhenNull="true">
                <reportElement x="105" y="80" width="250" height="20" forecolor="#2C3E50" backcolor="#ECF0F1" uuid="55555555-5555-5555-5555-555555555555"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[
                    "Period: " +
                    (($P{periodType} == "DAILY") ?
                        new java.text.SimpleDateFormat("MMM dd, yyyy").format($P{startDate}) + " to " + new java.text.SimpleDateFormat("MMM dd, yyyy").format($P{endDate}) :
                    ($P{periodType} == "MONTHLY") ?
                        new java.text.SimpleDateFormat("MMMM yyyy").format($P{startDate}) + " to " + new java.text.SimpleDateFormat("MMMM yyyy").format($P{endDate}) :
                        new java.text.SimpleDateFormat("yyyy").format($P{startDate}) + " to " + new java.text.SimpleDateFormat("yyyy").format($P{endDate}))
                ]]></textFieldExpression>
            </textField>

            <!-- Date -->
            <textField pattern="EEEE, MMMM dd, yyyy">
                <reportElement x="540" y="25" width="249" height="20" forecolor="#ECF0F1" uuid="66666666-6666-6666-6666-666666666666"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="11" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{REPORT_DATE}]]></textFieldExpression>
            </textField>

            <!-- Generated by -->
            <textField isBlankWhenNull="true">
                <reportElement x="540" y="50" width="249" height="18" forecolor="#BDC3C7" uuid="77777777-7777-7777-7777-777777777777"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="10"/>
                </textElement>
                <textFieldExpression><![CDATA["Generated by: " + $P{generatedBy}]]></textFieldExpression>
            </textField>

            <!-- Space Filter Info -->
            <textField isBlankWhenNull="true">
                <reportElement x="540" y="73" width="249" height="15" forecolor="#95A5A6" uuid="88888888-8888-8888-8888-888888888888"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
