<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="SpaceIncomeReport"
              pageWidth="842"
              pageHeight="595"
              orientation="Landscape"
              columnWidth="802"
              leftMargin="20"
              rightMargin="20"
              topMargin="20"
              bottomMargin="20"
              uuid="55093800-3e3e-406c-bcb4-0865490b911a">

    <property name="com.jaspersoft.studio.data.defaultdataadapter" value="One Empty Record"/>

    <!-- Parameters -->
    <parameter name="reportTitle" class="java.lang.String"/>
    <parameter name="startDate" class="java.sql.Date"/>
    <parameter name="endDate" class="java.sql.Date"/>
    <parameter name="branchId" class="java.lang.Long"/>
    <parameter name="periodType" class="java.lang.String"/>
    <parameter name="spaceCode" class="java.lang.String"/>
    <parameter name="generatedBy" class="java.lang.String"/>
    <parameter name="generatedAt" class="java.lang.String"/>
    <parameter name="companyName" class="java.lang.String" isForPrompting="false">
        <defaultValueExpression><![CDATA["Sein Gay Har"]]></defaultValueExpression>
    </parameter>
    <parameter name="COMPANY_LOGO" class="java.io.InputStream" isForPrompting="false"/>
    <parameter name="REPORT_DATE" class="java.util.Date" isForPrompting="false">
        <defaultValueExpression><![CDATA[new java.util.Date()]]></defaultValueExpression>
    </parameter>
    <queryString>
        <![CDATA[
SELECT
    s.space_code,
    st.type_name as space_type,
    f.level as floor_level,
    b.name as branch_name,
    p.amount,
    p.payment_date,
    CASE
        WHEN p.lease_id IS NOT NULL THEN 'LEASE'
        WHEN p.utility_id IS NOT NULL THEN 'UTILITY'
        ELSE 'OTHER'
    END as payment_type,

    -- CORRECTED: Get tenant name for BOTH lease AND utility payments
    COALESCE(
        -- For lease payments
        (SELECT u.full_name FROM users u
         JOIN lease l2 ON u.id = l2.tenant_user_id
         WHERE l2.lease_id = p.lease_id),

        -- For utility payments (using tenant_id in utility table)
        (SELECT u.full_name FROM users u
         WHERE u.id = ut.tenant_id),

        -- Fallback to email for lease payments
        (SELECT u.email FROM users u
         JOIN lease l2 ON u.id = l2.tenant_user_id
         WHERE l2.lease_id = p.lease_id),

        -- Fallback to email for utility payments
        (SELECT u.email FROM users u
         WHERE u.id = ut.tenant_id),

        'N/A'
    ) as tenant_name,

    p.status,
    p.payment_id,
    -- Utility type (if utility payment)
    CASE
        WHEN p.utility_id IS NOT NULL THEN 'UTILITY'
        ELSE ''
    END as utility_type
FROM payment p
-- Left join for lease payments
LEFT JOIN lease l ON p.lease_id = l.lease_id

-- Left join for utility payments (simple join) - THIS IS CRITICAL
LEFT JOIN utility ut ON p.utility_id = ut.utility_id

-- Common joins for space info
LEFT JOIN space s ON (l.space_id = s.space_id OR ut.space_id = s.space_id)
LEFT JOIN spacetype st ON s.space_type_id = st.space_type_id
LEFT JOIN floor f ON s.Floor_floor_id = f.floor_id
LEFT JOIN branches b ON f.branch_branch_id = b.id

WHERE p.status IN ('PAID', 'VERIFIED')
AND p.payment_date BETWEEN $P{startDate} AND $P{endDate}
AND ($P{spaceCode} IS NULL OR s.space_code = $P{spaceCode})
AND ($P{branchId} IS NULL OR b.id = $P{branchId})
ORDER BY p.payment_date DESC, s.space_code
]]>
    </queryString>

    <!-- Fields -->
    <field name="space_code" class="java.lang.String"/>
    <field name="space_type" class="java.lang.String"/>
    <field name="floor_level" class="java.lang.String"/>
    <field name="branch_name" class="java.lang.String"/>
    <field name="amount" class="java.math.BigDecimal"/>
    <field name="payment_date" class="java.sql.Date"/>
    <field name="payment_type" class="java.lang.String"/>
    <field name="tenant_name" class="java.lang.String"/>
    <field name="status" class="java.lang.String"/>
    <field name="payment_id" class="java.lang.Long"/>
    <field name="utility_type" class="java.lang.String"/>

    <!-- Variables -->
    <variable name="totalAmount" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{amount}]]></variableExpression>
    </variable>

    <variable name="totalSpaces" class="java.lang.Integer" calculation="DistinctCount">
        <variableExpression><![CDATA[$F{space_code}]]></variableExpression>
    </variable>

    <variable name="leasePayments" class="java.lang.Integer" calculation="Sum">
        <variableExpression><![CDATA[$F{payment_type}.equals("LEASE") ? 1 : 0]]></variableExpression>
    </variable>

    <variable name="utilityPayments" class="java.lang.Integer" calculation="Sum">
        <variableExpression><![CDATA[$F{payment_type}.equals("UTILITY") ? 1 : 0]]></variableExpression>
    </variable>

