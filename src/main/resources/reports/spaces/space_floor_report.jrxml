    </parameter>
    <parameter name="COMPANY_LOGO" class="java.io.InputStream" isForPrompting="false"/>
    <parameter name="REPORT_DATE" class="java.util.Date" isForPrompting="false">
        <defaultValueExpression><![CDATA[new java.util.Date()]]></defaultValueExpression>
    </parameter>
    <parameter name="GENERATED_BY" class="java.lang.String" isForPrompting="false">
        <defaultValueExpression><![CDATA["System Administrator"]]></defaultValueExpression>
    </parameter>
    <parameter name="REPORT_ID" class="java.lang.String" isForPrompting="false">
        <defaultValueExpression><![CDATA["FLOOR-" + new java.util.Date().getTime()]]></defaultValueExpression>
    </parameter>
    <parameter name="FLOOR_ID" class="java.lang.Integer">
        <defaultValueExpression><![CDATA[0]]></defaultValueExpression>
    </parameter>
    <parameter name="FLOOR_LEVEL" class="java.lang.String">
        <defaultValueExpression><![CDATA[""]]></defaultValueExpression>
    </parameter>
    <parameter name="BRANCH_NAME" class="java.lang.String">
        <defaultValueExpression><![CDATA[""]]></defaultValueExpression>
    </parameter>

    <queryString>
        <![CDATA[
    SELECT
        s.space_code,
        s.location,
        s.size_sqft,
        s.price,
        s.status,
        st.type_name as space_type,
        f.floor_id,  -- ADD THIS: Get the floor ID from the query
        f.level as floor_level,
        b.name as branch_name,
        s.amenities
    FROM space s
    LEFT JOIN spacetype st ON s.space_type_id = st.space_type_id
    LEFT JOIN floor f ON s.Floor_floor_id = f.floor_id
    LEFT JOIN branches b ON f.branch_branch_id = b.id
    WHERE f.floor_id = $P{FLOOR_ID}
    ORDER BY s.space_code
    ]]>
    </queryString>

    <field name="space_code" class="java.lang.String"/>
    <field name="location" class="java.lang.String"/>
    <field name="size_sqft" class="java.lang.Double"/>
    <field name="price" class="java.lang.Double"/>
    <field name="status" class="java.lang.String"/>
    <field name="space_type" class="java.lang.String"/>
    <field name="floor_id" class="java.lang.Integer"/>  <!-- ADD THIS FIELD -->
    <field name="floor_level" class="java.lang.String"/>
    <field name="branch_name" class="java.lang.String"/>
    <field name="amenities" class="java.lang.String"/>

    <variable name="TOTAL_SPACES" class="java.lang.Integer" calculation="Count">
        <variableExpression><![CDATA[$F{space_code}]]></variableExpression>
    </variable>

    <variable name="VACANT_COUNT" class="java.lang.Integer" calculation="Count">
        <variableExpression><![CDATA["VACANT".equals($F{status}) ? $F{space_code} : null]]></variableExpression>
    </variable>

    <variable name="OCCUPIED_COUNT" class="java.lang.Integer" calculation="Count">
        <variableExpression><![CDATA["OCCUPIED".equals($F{status}) ? $F{space_code} : null]]></variableExpression>
    </variable>

    <variable name="TOTAL_AREA" class="java.lang.Double" calculation="Sum">
        <variableExpression><![CDATA[$F{size_sqft}]]></variableExpression>
    </variable>

    <variable name="TOTAL_VALUE" class="java.lang.Double" calculation="Sum">
        <variableExpression><![CDATA[$F{price} != null ? $F{price} : 0]]></variableExpression>
    </variable>

    <!-- Title Band -->
    <title>
        <band height="150" splitType="Stretch">
            <!-- Header Background -->
            <rectangle radius="8">
                <reportElement x="0" y="0" width="555" height="120" backcolor="#2C3E50"/>
                <graphicElement>
                    <pen lineWidth="0.0" lineColor="#2C3E50"/>
                </graphicElement>
            </rectangle>

            <!-- Logo -->
            <image scaleImage="RetainShape" onErrorType="Blank">
                <reportElement x="20" y="25" width="60" height="60"/>
                <imageExpression><![CDATA[$P{COMPANY_LOGO}]]></imageExpression>
            </image>

            <!-- Company Name -->
            <textField isBlankWhenNull="true">
                <reportElement x="100" y="25" width="300" height="25" forecolor="#FFFFFF"/>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="16" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{COMPANY_NAME}]]></textFieldExpression>
            </textField>

            <!-- Report Title -->
            <textField isBlankWhenNull="true">
                <reportElement x="100" y="55" width="300" height="20" forecolor="#ECF0F1"/>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="12"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{REPORT_TITLE}]]></textFieldExpression>
            </textField>

            <!-- Floor and Branch Info - Show floor ID from query result -->
            <textField isBlankWhenNull="true">
                <reportElement x="100" y="80" width="300" height="30" forecolor="#BDC3C7"/>
                <textElement textAlignment="Left" verticalAlignment="Top">
                    <font fontName="DejaVu Sans" size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[
                    "Floor ID: " + ($F{floor_id} != null ? $F{floor_id}.toString() : "N/A") +
                    " | Level: " + ($F{floor_level} != null ? $F{floor_level} : "Unknown") +
                    ($F{branch_name} != null ? " | Branch: " + $F{branch_name} : "")
                ]]></textFieldExpression>
            </textField>

            <!-- Date -->
            <textField pattern="EEE, MMM dd, yyyy">
                <reportElement x="420" y="25" width="130" height="20" forecolor="#ECF0F1"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{REPORT_DATE}]]></textFieldExpression>
            </textField>

            <!-- Generated by -->
            <textField isBlankWhenNull="true">
                <reportElement x="420" y="50" width="130" height="18" forecolor="#BDC3C7"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["By: " + $P{GENERATED_BY}]]></textFieldExpression>
            </textField>

            <!-- Report ID -->
            <textField isBlankWhenNull="true">
                <reportElement x="420" y="73" width="130" height="15" forecolor="#95A5A6"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["ID: " + $P{REPORT_ID}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <!-- Column Header -->
    <columnHeader>
        <band height="50" splitType="Stretch">
            <!-- Table Header Background -->
            <rectangle radius="5">
                <reportElement x="0" y="0" width="555" height="45" backcolor="#34495E"/>
                <graphicElement>
                    <pen lineWidth="0.0" lineColor="#34495E"/>
                </graphicElement>
            </rectangle>

            <!-- Column Headers -->
            <staticText>
                <reportElement x="5" y="10" width="80" height="25" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="10" isBold="true"/>
                </textElement>
