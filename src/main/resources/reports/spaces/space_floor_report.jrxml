    <!-- Detail -->
    <detail>
        <band height="50" splitType="Stretch">
            <!-- Alternating row background -->
            <rectangle>
                <reportElement x="0" y="0" width="555" height="40" mode="Opaque" backcolor="#F8F9FA">
                    <printWhenExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></printWhenExpression>
                </reportElement>
                <graphicElement>
                    <pen lineWidth="0.0" lineColor="#F8F9FA"/>
                </graphicElement>
            </rectangle>

            <!-- Space Code -->
            <textField isBlankWhenNull="true">
                <reportElement x="5" y="10" width="80" height="20"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{space_code}]]></textFieldExpression>
            </textField>

            <!-- Space Type -->
            <textField isBlankWhenNull="true">
                <reportElement x="90" y="10" width="100" height="20"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{space_type}]]></textFieldExpression>
            </textField>

            <!-- Size -->
            <textField pattern="#,##0.00">
                <reportElement x="195" y="10" width="80" height="20"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{size_sqft}]]></textFieldExpression>
            </textField>

            <!-- Price -->
            <textField pattern="$#,##0.00">
                <reportElement x="280" y="10" width="80" height="20"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{price}]]></textFieldExpression>
            </textField>

            <!-- Status Badge -->
            <rectangle radius="8">
                <reportElement x="365" y="10" width="70" height="20" mode="Opaque" backcolor="#6C757D">
                    <printWhenExpression><![CDATA[$F{status} != null]]></printWhenExpression>
                </reportElement>
                <graphicElement>
                    <pen lineWidth="0.5" lineColor="#DEE2E6"/>
                </graphicElement>
            </rectangle>
            <textField isBlankWhenNull="true">
                <reportElement x="365" y="10" width="70" height="20" forecolor="#FFFFFF">
                    <printWhenExpression><![CDATA[$F{status} != null]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="8" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{status}]]></textFieldExpression>
            </textField>

            <!-- Location -->
            <textField isBlankWhenNull="true">
                <reportElement x="440" y="10" width="110" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{location}]]></textFieldExpression>
            </textField>

            <!-- Bottom border -->
            <line>
                <reportElement x="0" y="39" width="555" height="1"/>
                <graphicElement>
                    <pen lineWidth="0.5" lineColor="#E9ECEF"/>
                </graphicElement>
            </line>
        </band>
    </detail>

    <!-- Page Footer -->
    <pageFooter>
        <band height="40" splitType="Stretch">
            <!-- Confidential watermark -->
            <textField>
                <reportElement x="0" y="5" width="555" height="15" forecolor="#D1D5DB"/>
                <textElement textAlignment="Center">
                    <font fontName="DejaVu Sans" size="7"/>
                </textElement>
                <textFieldExpression><![CDATA["CONFIDENTIAL - For Internal Use Only"]]></textFieldExpression>
            </textField>

            <!-- Page counter -->
            <textField>
                <reportElement x="0" y="20" width="275" height="15"/>
                <textElement textAlignment="Left">
                    <font fontName="DejaVu Sans" size="8" isItalic="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER} + " of " + $V{PAGE_COUNT}]]></textFieldExpression>
            </textField>

            <!-- Page number -->
            <textField pattern="HH:mm:ss">
                <reportElement x="280" y="20" width="275" height="15"/>
                <textElement textAlignment="Right">
                    <font fontName="DejaVu Sans" size="8" isItalic="true"/>
                </textElement>
                <textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <!-- Summary -->
    <summary>
        <band height="80" splitType="Stretch">
            <!-- Summary Background -->
            <rectangle radius="5">
                <reportElement x="0" y="0" width="555" height="70" backcolor="#2C3E50"/>
                <graphicElement>
                    <pen lineWidth="0.0" lineColor="#2C3E50"/>
                </graphicElement>
            </rectangle>

            <!-- Statistics -->
            <textField evaluationTime="Report">
                <reportElement x="20" y="15" width="150" height="20" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Total Spaces: " + $V{TOTAL_SPACES}]]></textFieldExpression>
            </textField>

            <textField evaluationTime="Report">
                <reportElement x="20" y="40" width="150" height="20" forecolor="#BDC3C7"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["Vacant: " + $V{VACANT_COUNT} + " | Occupied: " + $V{OCCUPIED_COUNT}]]></textFieldExpression>
            </textField>

            <textField evaluationTime="Report">
                <reportElement x="200" y="15" width="180" height="20" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Total Area: " + $V{TOTAL_AREA} + " sqft"]]></textFieldExpression>
            </textField>

            <textField evaluationTime="Report">
                <reportElement x="200" y="40" width="180" height="20" forecolor="#BDC3C7"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["Total Value: $" + $V{TOTAL_VALUE}]]></textFieldExpression>
            </textField>

            <!-- Report Generation Time -->
            <textField pattern="EEE, MMM dd, yyyy HH:mm:ss">
                <reportElement x="400" y="15" width="135" height="20" forecolor="#BDC3C7"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression>
            </textField>
        </band>
    </summary>
</jasperReport>