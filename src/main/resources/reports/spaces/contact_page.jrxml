<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="contact_page"
              pageWidth="595"
              pageHeight="842"
              columnWidth="555"
              leftMargin="20"
              rightMargin="20"
              topMargin="20"
              bottomMargin="20">

    <parameter name="COMPANY_NAME" class="java.lang.String"/>
    <parameter name="REPORT_TITLE" class="java.lang.String"/>
    <parameter name="spaceCode" class="java.lang.String"/>
    <parameter name="CONTACT_PERSON" class="java.lang.String"/>
    <parameter name="CONTACT_PHONE" class="java.lang.String"/>
    <parameter name="CONTACT_EMAIL" class="java.lang.String"/>
    <parameter name="SPECIAL_FEATURES" class="java.lang.String"/>

    <field name="spaceCode" class="java.lang.String"/>
    <field name="specialFeatures" class="java.lang.String"/>

    <background>
        <band height="802">
            <rectangle>
                <reportElement x="0" y="0" width="555" height="802" backcolor="#F8F9FA"/>
            </rectangle>
        </band>
    </background>

    <title>
        <band height="100">
            <rectangle radius="10">
                <reportElement x="0" y="0" width="555" height="80" backcolor="#2C3E50"/>
            </rectangle>

            <image onErrorType="Blank">
                <reportElement x="20" y="15" width="40" height="40"/>
                <imageExpression><![CDATA["classpath:image/SGH-logo.png"]]></imageExpression>
            </image>

            <textField>
                <reportElement x="70" y="15" width="250" height="20" forecolor="#FFFFFF"/>
                <textElement><font size="14" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{COMPANY_NAME}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="70" y="40" width="250" height="25" forecolor="#ECF0F1"/>
                <textElement><font size="18" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{REPORT_TITLE} + " - Contact Information"]]></textFieldExpression>
            </textField>

            <rectangle radius="8">
                <reportElement x="400" y="15" width="135" height="25" backcolor="#3498DB"/>
            </rectangle>

            <textField>
                <reportElement x="400" y="15" width="135" height="25" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center"><font size="11" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["ID: " + $F{spaceCode}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <detail>
        <band height="600">
            <!-- Contact Information Section -->
            <rectangle radius="8">
                <reportElement x="0" y="0" width="555" height="300" backcolor="#FFFFFF"/>
            </rectangle>

            <staticText>
                <reportElement x="10" y="10" width="535" height="30" forecolor="#2C3E50"/>
                <textElement><font size="16" isBold="true"/></textElement>
                <text><![CDATA[Contact Information]]></text>
            </staticText>

            <!-- Contact Person -->
            <staticText>
                <reportElement x="30" y="60" width="120" height="25" forecolor="#7F8C8D"/>
                <textElement><font size="12" isBold="true"/></textElement>
                <text><![CDATA[Contact Person:]]></text>
            </staticText>

            <textField>
                <reportElement x="160" y="60" width="350" height="25" forecolor="#2C3E50"/>
                <textElement><font size="12" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{CONTACT_PERSON}]]></textFieldExpression>
            </textField>

            <!-- Phone -->
            <staticText>
                <reportElement x="30" y="100" width="120" height="25" forecolor="#7F8C8D"/>
                <textElement><font size="12" isBold="true"/></textElement>
                <text><![CDATA[Phone Number:]]></text>
            </staticText>

            <textField>
                <reportElement x="160" y="100" width="350" height="25" forecolor="#2C3E50"/>
                <textElement><font size="12"/></textElement>
                <textFieldExpression><![CDATA[$P{CONTACT_PHONE}]]></textFieldExpression>
            </textField>

            <!-- Email -->
            <staticText>
                <reportElement x="30" y="140" width="120" height="25" forecolor="#7F8C8D"/>
                <textElement><font size="12" isBold="true"/></textElement>
                <text><![CDATA[Email Address:]]></text>
            </staticText>

            <textField>
                <reportElement x="160" y="140" width="350" height="25" forecolor="#3498DB"/>
                <textElement><font size="12"/></textElement>
                <textFieldExpression><![CDATA[$P{CONTACT_EMAIL}]]></textFieldExpression>
            </textField>

            <!-- Additional Information -->
            <rectangle radius="8">
                <reportElement x="0" y="320" width="555" height="250" backcolor="#2C3E50"/>
            </rectangle>

            <staticText>
                <reportElement x="10" y="330" width="535" height="30" forecolor="#FFFFFF"/>
                <textElement><font size="14" isBold="true"/></textElement>
                <text><![CDATA[Additional Information]]></text>
            </staticText>

            <!-- Special Features -->
            <staticText>
                <reportElement x="30" y="380" width="120" height="20" forecolor="#BDC3C7"/>
                <textElement><font size="10" isBold="true"/></textElement>
                <text><![CDATA[Special Features:]]></text>
            </staticText>

            <textField>
                <reportElement x="160" y="380" width="350" height="80" forecolor="#ECF0F1"/>
                <textElement><font size="10"/></textElement>
                <textFieldExpression><![CDATA[$F{specialFeatures} != null ? $F{specialFeatures} : "No special features listed"]]></textFieldExpression>
            </textField>

            <!-- Company Info -->
            <staticText>
                <reportElement x="30" y="480" width="500" height="15" forecolor="#BDC3C7"/>
                <textElement textAlignment="Center"><font size="9" isItalic="true"/></textElement>
                <text><![CDATA["Available 24/7 for inquiries"]]></text>
            </staticText>

            <staticText>
                <reportElement x="30" y="500" width="500" height="15" forecolor="#BDC3C7"/>
                <textElement textAlignment="Center"><font size="9" isItalic="true"/></textElement>
                <text><![CDATA["Visit: www.seingarhar.com"]]></text>
            </staticText>

            <staticText>
                <reportElement x="30" y="520" width="500" height="15" forecolor="#BDC3C7"/>
                <textElement textAlignment="Center"><font size="9" isItalic="true"/></textElement>
                <text><![CDATA["Professional property management"]]></text>
            </staticText>
        </band>
    </detail>

    <pageFooter>
        <band height="40">
            <line>
                <reportElement x="0" y="0" width="555" height="1"/>
            </line>

            <textField evaluationTime="Now">
                <reportElement x="0" y="5" width="275" height="15" forecolor="#7F8C8D"/>
                <textElement textAlignment="Left"><font size="8"/></textElement>
                <textFieldExpression><![CDATA["Generated on " + new java.util.Date()]]></textFieldExpression>
            </textField>

            <textField evaluationTime="Report">
                <reportElement x="280" y="5" width="275" height="15" forecolor="#7F8C8D"/>
                <textElement textAlignment="Right"><font size="8"/></textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER} + " of " + $V{PAGE_COUNT}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="0" y="22" width="555" height="12" forecolor="#95A5A6"/>
                <textElement textAlignment="Center"><font size="7" isItalic="true"/></textElement>
                <textFieldExpression><![CDATA["Confidential - For Internal Use Only"]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>
</jasperReport>