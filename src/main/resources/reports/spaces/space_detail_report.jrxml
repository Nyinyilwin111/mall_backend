<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="space_detail_report"
              pageWidth="595"
              pageHeight="842"
              columnWidth="555"
              leftMargin="20"
              rightMargin="20"
              topMargin="20"
              bottomMargin="20"
              isTitleNewPage="false"
              isSummaryWithPageHeaderAndFooter="false">

    <property name="com.jaspersoft.studio.data.defaultdataadapter" value="One Empty Record"/>

    <!-- Main Report Parameters -->
    <parameter name="COMPANY_NAME" class="java.lang.String"/>
    <parameter name="REPORT_TITLE" class="java.lang.String"/>
    <parameter name="REPORT_DATE" class="java.util.Date"/>

    <!-- Contact Information Parameters -->
    <parameter name="CONTACT_PERSON" class="java.lang.String"/>
    <parameter name="CONTACT_PHONE" class="java.lang.String"/>
    <parameter name="CONTACT_EMAIL" class="java.lang.String"/>

    <!-- Subreport Parameters -->
    <parameter name="amenitiesSubreport" class="net.sf.jasperreports.engine.JasperReport"/>
    <parameter name="amenitiesDataSource" class="net.sf.jasperreports.engine.JRDataSource"/>

    <field name="spaceId" class="java.lang.String"/>
    <field name="spaceCode" class="java.lang.String"/>
    <field name="location" class="java.lang.String"/>
    <field name="sizeSqft" class="java.lang.Double"/>
    <field name="price" class="java.math.BigDecimal"/>
    <field name="amenities" class="java.lang.String"/>
    <field name="amenityList" class="java.util.List"/>
    <field name="amenityItems" class="java.util.List"/>
    <field name="status" class="java.lang.String"/>
    <field name="spaceType" class="java.lang.String"/>
    <field name="floorLevel" class="java.lang.String"/>
    <field name="branchName" class="java.lang.String"/>
    <field name="createdAt" class="java.time.LocalDateTime"/>
    <field name="imageCount" class="java.lang.Integer"/>
    <field name="imageUrls" class="java.util.List"/>
    <field name="description" class="java.lang.String"/>
    <field name="specialFeatures" class="java.lang.String"/>
    <field name="contactPerson" class="java.lang.String"/>
    <field name="contactPhone" class="java.lang.String"/>
    <field name="contactEmail" class="java.lang.String"/>

    <variable name="currentImageIndex" class="java.lang.Integer" calculation="Count">
        <variableExpression><![CDATA[$F{imageUrls} != null ? 1 : 0]]></variableExpression>
        <initialValueExpression><![CDATA[0]]></initialValueExpression>
    </variable>

    <background >
<!--        <band height="802">-->
<!--            <rectangle>-->
<!--                <reportElement x="0" y="0" width="555" height="802" backcolor="#F8F9FA"/>-->
<!--            </rectangle>-->
<!--        </band>-->
    </background>

    <title>
        <band height="100">
            <rectangle radius="10">
                <reportElement x="0" y="0" width="555" height="80" backcolor="#2C3E50"/>
            </rectangle>

            <image onErrorType="Blank">
                <reportElement x="20" y="15" width="40" height="40"/>
                <imageExpression><![CDATA["classpath:image/SGH-logo.png"]]></imageExpression>
            </image>

            <textField>
                <reportElement x="70" y="15" width="250" height="20" forecolor="#FFFFFF"/>
                <textElement><font size="13" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{COMPANY_NAME}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="70" y="40" width="250" height="25" forecolor="#ECF0F1"/>
                <textElement><font size="11" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{REPORT_TITLE}]]></textFieldExpression>
            </textField>

            <rectangle radius="8">
                <reportElement x="400" y="15" width="135" height="25" backcolor="#3498DB"/>
            </rectangle>

            <textField>
                <reportElement x="400" y="15" width="135" height="25" forecolor="#FFFFFF" />
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="11" isBold="true" /></textElement>
                <textFieldExpression><![CDATA["ID: " + $F{spaceCode}]]></textFieldExpression>
            </textField>

            <textField pattern="EEEE, MMMM dd, yyyy">
                <reportElement x="400" y="45" width="135" height="15" forecolor="#BDC3C7"/>
                <textElement textAlignment="Right"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$P{REPORT_DATE}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="0" y="85" width="555" height="15" forecolor="#7F8C8D"/>
                <textElement textAlignment="Center"><font size="8" isItalic="true"/></textElement>
                <textFieldExpression><![CDATA["Page 1 of 2 - Unit Details & Amenities"]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <detail>
        <band height="650">
            <!-- Space Images Section -->
            <rectangle radius="8">
                <reportElement x="0" y="0" width="555" height="150" backcolor="#FFFFFF"/>
            </rectangle>

            <staticText>
                <reportElement x="10" y="10" width="535" height="20" />
                <textElement><font size="12" isBold="true"/></textElement>
                <text><![CDATA[Unit Images]]></text>
            </staticText>

            <!-- Image 1 -->
            <image scaleImage="RetainShape" onErrorType="Blank">
                <reportElement x="15" y="35" width="170" height="105">
                    <printWhenExpression><![CDATA[$F{imageUrls} != null && $F{imageUrls}.size() >= 1]]></printWhenExpression>
                </reportElement>
                <imageExpression><![CDATA[$F{imageUrls} != null && $F{imageUrls}.size() >= 1 ?
    ((String)$F{imageUrls}.get(0)) : null]]></imageExpression>
            </image>

            <!-- Image 2 -->
            <image scaleImage="RetainShape" onErrorType="Blank">
                <reportElement x="195" y="35" width="170" height="105">
                    <printWhenExpression><![CDATA[$F{imageUrls} != null && $F{imageUrls}.size() >= 2]]></printWhenExpression>
                </reportElement>
                <imageExpression><![CDATA[$F{imageUrls} != null && $F{imageUrls}.size() >= 2 ?
    ((String)$F{imageUrls}.get(1)) : null]]></imageExpression>
            </image>

            <!-- Image 3 -->
            <image scaleImage="RetainShape" onErrorType="Blank">
                <reportElement x="375" y="35" width="170" height="105">
                    <printWhenExpression><![CDATA[$F{imageUrls} != null && $F{imageUrls}.size() >= 3]]></printWhenExpression>
                </reportElement>
                <imageExpression><![CDATA[$F{imageUrls} != null && $F{imageUrls}.size() >= 3 ?
    ((String)$F{imageUrls}.get(2)) : null]]></imageExpression>
            </image>

            <!-- No Images Message -->
            <textField>
                <reportElement x="0" y="60" width="555" height="20" forecolor="#CF2323">
                    <printWhenExpression><![CDATA[$F{imageUrls} == null || $F{imageUrls}.isEmpty()]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Center"><font size="10" isItalic="true"/></textElement>
                <textFieldExpression><![CDATA["No images available for this space"]]></textFieldExpression>
            </textField>

            <!-- Space Information Section -->
            <rectangle radius="8">
                <reportElement x="0" y="160" width="555" height="170" backcolor="#D6D6D6"/>
            </rectangle>

            <staticText>
                <reportElement x="10" y="170" width="535" height="30" forecolor="#2C3E50"/>
                <textElement><font size="12" isBold="true"/></textElement>
                <text><![CDATA[Unit Information]]></text>
            </staticText>

            <!-- Location -->
            <staticText>
                <reportElement x="20" y="200" width="70" height="30" forecolor="#7F8C8D"/>
                <textElement><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Location:]]></text>
            </staticText>
            <textField>
                <reportElement x="90" y="200" width="190" height="30"/>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{location}]]></textFieldExpression>
            </textField>

            <!-- Size -->
            <staticText>
                <reportElement x="300" y="200" width="70" height="30" forecolor="#7F8C8D"/>
                <textElement><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Size:]]></text>
            </staticText>
            <textField>
                <reportElement x="370" y="200" width="165" height="30"/>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{sizeSqft} != null ? java.lang.String.format("%,.2f", $F{sizeSqft}) + " sq.ft." : "N/A"]]></textFieldExpression>
            </textField>

            <!-- Price -->
            <staticText>
                <reportElement x="20" y="230" width="70" height="30" forecolor="#7F8C8D"/>
                <textElement><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Price:]]></text>
            </staticText>
            <textField>
                <reportElement x="90" y="230" width="190" height="30" forecolor="#27AE60"/>
                <textElement><font size="10" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{price} != null ? "$" + java.lang.String.format("%,.2f", $F{price}) + " /month" : "Price not set"]]></textFieldExpression>
            </textField>

            <!-- Status -->
            <staticText>
                <reportElement x="300" y="230" width="70" height="20" forecolor="#7F8C8D"/>
                <textElement><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Status:]]></text>
            </staticText>
            <rectangle radius="10">
                <reportElement x="370" y="230" width="70" height="20" backcolor="#27AE60">
                    <printWhenExpression><![CDATA["VACANT".equals($F{status})]]></printWhenExpression>
                </reportElement>
            </rectangle>
            <rectangle radius="10">
                <reportElement x="370" y="230" width="70" height="20" backcolor="#E74C3C">
                    <printWhenExpression><![CDATA["OCCUPIED".equals($F{status})]]></printWhenExpression>
                </reportElement>
            </rectangle>
            <textField>
                <reportElement x="370" y="230" width="70" height="20" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{status}]]></textFieldExpression>
            </textField>

            <!-- Type -->
            <staticText>
                <reportElement x="20" y="255" width="70" height="30" forecolor="#7F8C8D"/>
                <textElement><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Type:]]></text>
            </staticText>
            <textField>
                <reportElement x="90" y="255" width="190" height="30"/>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{spaceType}]]></textFieldExpression>
            </textField>

            <!-- Floor -->
            <staticText>
                <reportElement x="300" y="255" width="70" height="30" forecolor="#7F8C8D"/>
                <textElement><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Floor:]]></text>
            </staticText>
            <textField>
                <reportElement x="370" y="255" width="165" height="30"/>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{floorLevel}]]></textFieldExpression>
            </textField>

            <!-- Branch -->
            <staticText>
                <reportElement x="20" y="280" width="70" height="30" forecolor="#7F8C8D"/>
                <textElement><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Branch:]]></text>
            </staticText>
            <textField>
                <reportElement x="90" y="280" width="190" height="30"/>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{branchName}]]></textFieldExpression>
            </textField>

            <!-- Created -->
            <staticText>
                <reportElement x="300" y="280" width="70" height="30" forecolor="#7F8C8D"/>
                <textElement><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Created:]]></text>
            </staticText>
            <textField>
                <reportElement x="370" y="280" width="165" height="30"/>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{createdAt} != null ? $F{createdAt}.format(java.time.format.DateTimeFormatter.ofPattern("MMM dd, yyyy")) : "N/A"]]></textFieldExpression>
            </textField>

            <!-- Description -->
            <staticText>
                <reportElement x="20" y="305" width="70" height="30" forecolor="#7F8C8D"/>
                <textElement><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Description:]]></text>
            </staticText>
            <textField>
                <reportElement x="90" y="305" width="445" height="30"/>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{description}]]></textFieldExpression>
            </textField>

            <!-- Amenities Section -->
            <rectangle radius="8">
                <reportElement x="0" y="345" width="555" height="285" backcolor="#FFFFFF"/>
            </rectangle>

            <staticText>
                <reportElement x="10" y="355" width="535" height="20" forecolor="#2C3E50"/>
                <textElement><font size="12" isBold="true"/></textElement>
                <text><![CDATA[Amenities & Features]]></text>
            </staticText>

            <!-- Amenities Subreport -->
            <subreport>
                <reportElement x="10" y="375" width="535" height="245"/>
                <dataSourceExpression><![CDATA[$P{amenitiesDataSource}]]></dataSourceExpression>
                <subreportExpression><![CDATA[$P{amenitiesSubreport}]]></subreportExpression>
            </subreport>

            <!-- Next Page Indicator -->
            <textField>
                <reportElement x="0" y="635" width="555" height="15" forecolor="#7F8C8D"/>
                <textElement textAlignment="Center"><font size="8" isItalic="true"/></textElement>
                <textFieldExpression><![CDATA["Continued on page 2 - Contact Information..."]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="40">
            <line>
                <reportElement x="0" y="0" width="555" height="1"/>
            </line>

            <textField evaluationTime="Now">
                <reportElement x="0" y="5" width="275" height="15" forecolor="#7F8C8D"/>
                <textElement textAlignment="Left"><font size="8"/></textElement>
                <textFieldExpression><![CDATA["Generated on " + new java.util.Date()]]></textFieldExpression>
            </textField>

            <textField evaluationTime="Report">
                <reportElement x="280" y="5" width="275" height="15" forecolor="#7F8C8D"/>
                <textElement textAlignment="Right"><font size="8"/></textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="0" y="22" width="555" height="12" forecolor="#95A5A6"/>
                <textElement textAlignment="Center"><font size="7" isItalic="true"/></textElement>
                <textFieldExpression><![CDATA["Confidential - For Internal Use Only"]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <!-- Contact Page as Summary (Page 2) -->
    <!-- Contact Page as Summary (Page 2) -->
    <summary>
        <band height="615">  <!-- Changed from 600 to 615 -->
            <!-- Contact Information Section -->
            <rectangle radius="8">
                <reportElement x="0" y="0" width="555" height="200" backcolor="#FFFFFF"/>
            </rectangle>

            <staticText>
                <reportElement x="10" y="9" width="535" height="30" forecolor="#2C3E50"/>
                <textElement><font size="16" isBold="true"/></textElement>
                <text><![CDATA[Contact Information]]></text>
            </staticText>
            <!-- Contact Person -->
            <staticText>
                <reportElement x="10" y="74" width="120" height="25" forecolor="#7F8C8D"/>
                <textElement><font size="12" isBold="true"/></textElement>
                <text><![CDATA[Contact Person:]]></text>
            </staticText>
            <textField>
                <reportElement x="143" y="74" width="350" height="25" forecolor="#2C3E50"/>
                <textElement><font size="12" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{contactPerson} != null ? $F{contactPerson} : $P{CONTACT_PERSON}]]></textFieldExpression>
            </textField>

            <!-- Phone -->
            <staticText>
                <reportElement x="10" y="108" width="120" height="25" forecolor="#7F8C8D"/>
                <textElement><font size="12" isBold="true"/></textElement>
                <text><![CDATA[Phone Number:]]></text>
            </staticText>
            <textField>
                <reportElement x="140" y="108" width="350" height="25" forecolor="#2C3E50"/>
                <textElement><font size="12"/></textElement>
                <textFieldExpression><![CDATA[$F{contactPhone} != null ? $F{contactPhone} : $P{CONTACT_PHONE}]]></textFieldExpression>
            </textField>

            <!-- Email -->
            <staticText>
                <reportElement x="10" y="138" width="120" height="25" forecolor="#7F8C8D"/>
                <textElement><font size="12" isBold="true"/></textElement>
                <text><![CDATA[Email Address:]]></text>
            </staticText>
            <textField>
                <reportElement x="140" y="138" width="350" height="25" forecolor="#3498DB"/>
                <textElement><font size="12"/></textElement>
                <textFieldExpression><![CDATA[$F{contactEmail} != null ? $F{contactEmail} : $P{CONTACT_EMAIL}]]></textFieldExpression>
            </textField>

            <!-- Additional Information -->
            <rectangle radius="8">
                <reportElement x="0" y="218" width="555" height="200" backcolor="#2C3E50"/>
            </rectangle>

            <staticText>
                <reportElement x="10" y="228" width="535" height="30" forecolor="#FFFFFF"/>
                <textElement><font size="14" isBold="true"/></textElement>
                <text><![CDATA[Additional Information]]></text>
            </staticText>

            <!-- Special Features -->
            <staticText>
                <reportElement x="30" y="268" width="120" height="20" forecolor="#BDC3C7"/>
                <textElement><font size="10" isBold="true"/></textElement>
                <text><![CDATA[Special Features:]]></text>
            </staticText>
            <textField>
                <reportElement x="160" y="268" width="350" height="60" forecolor="#ECF0F1"/>
                <textElement><font size="10"/></textElement>
                <textFieldExpression><![CDATA[$F{specialFeatures} != null ? $F{specialFeatures} : "No special features listed"]]></textFieldExpression>
            </textField>

            <!-- Company Info -->
            <staticText>
                <reportElement x="30" y="338" width="500" height="15" forecolor="#BDC3C7"/>
                <textElement textAlignment="Center"><font size="9" isItalic="true"/></textElement>
                <text><![CDATA["Available 24/7 for inquiries"]]></text>
            </staticText>

            <staticText>
                <reportElement x="30" y="358" width="500" height="15" forecolor="#BDC3C7"/>
                <textElement textAlignment="Center"><font size="9" isItalic="true"/></textElement>
                <text><![CDATA["Visit: www.seingarhar.com"]]></text>
            </staticText>

            <staticText>
                <reportElement x="30" y="378" width="500" height="15" forecolor="#BDC3C7"/>
                <textElement textAlignment="Center"><font size="9" isItalic="true"/></textElement>
                <text><![CDATA["Professional property management"]]></text>
            </staticText>

            <!-- Footer for Page 2 -->
            <line>
                <reportElement x="0" y="579" width="555" height="1"/>
            </line>

            <textField evaluationTime="Now">
                <reportElement x="0" y="584" width="275" height="15" forecolor="#7F8C8D"/>
                <textElement textAlignment="Left"><font size="8"/></textElement>
                <textFieldExpression><![CDATA["Generated on " + new java.util.Date()]]></textFieldExpression>
            </textField>

            <textField evaluationTime="Report">
                <reportElement x="280" y="584" width="275" height="15" forecolor="#7F8C8D"/>
                <textElement textAlignment="Right"><font size="8"/></textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="0" y="601" width="555" height="12" forecolor="#95A5A6"/>
                <textElement textAlignment="Center"><font size="7" isItalic="true"/></textElement>
                <textFieldExpression><![CDATA["Confidential - For Internal Use Only"]]></textFieldExpression>
            </textField>
        </band>
    </summary>
</jasperReport>