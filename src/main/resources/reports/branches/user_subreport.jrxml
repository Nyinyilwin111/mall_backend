<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
                                  http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="user_subreport"
              pageWidth="555"
              pageHeight="100"
              columnWidth="555"
              leftMargin="0"
              rightMargin="0"
              topMargin="0"
              bottomMargin="0">

    <!-- ✅ ALL fields as java.lang.String to handle UUID and null values -->
    <field name="id" class="java.lang.String"/>
    <field name="username" class="java.lang.String"/>
    <field name="email" class="java.lang.String"/>
    <field name="firstName" class="java.lang.String"/>
    <field name="lastName" class="java.lang.String"/>
    <field name="fullName" class="java.lang.String"/>
    <field name="role" class="java.lang.String"/>
    <field name="status" class="java.lang.String"/>

    <columnHeader>
        <band height="25">
            <staticText>
                <reportElement x="0" y="0" width="40" height="20" forecolor="#2C3E50"/>
                <textElement verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[ID]]></text>
            </staticText>
            <staticText>
                <reportElement x="50" y="0" width="80" height="20" forecolor="#2C3E50"/>
                <textElement verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Username]]></text>
            </staticText>
            <staticText>
                <reportElement x="140" y="0" width="120" height="20" forecolor="#2C3E50"/>
                <textElement verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Full Name]]></text>
            </staticText>
            <staticText>
                <reportElement x="270" y="0" width="120" height="20" forecolor="#2C3E50"/>
                <textElement verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Email]]></text>
            </staticText>
            <staticText>
                <reportElement x="400" y="0" width="60" height="20" forecolor="#2C3E50"/>
                <textElement verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Role]]></text>
            </staticText>
            <staticText>
                <reportElement x="470" y="0" width="60" height="20" forecolor="#2C3E50"/>
                <textElement verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Status]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="20">
            <!-- ✅ Display shortened UUID -->
            <textField>
                <reportElement x="0" y="0" width="40" height="20"/>
                <textElement verticalAlignment="Middle">
                    <font size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[
                    $F{id} != null && $F{id}.length() > 8 ?
                    $F{id}.substring(0, 8) + "..." :
                    $F{id}
                ]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="50" y="0" width="80" height="20"/>
                <textElement verticalAlignment="Middle">
                    <font size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{username}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="140" y="0" width="120" height="20"/>
                <textElement verticalAlignment="Middle">
                    <font size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{fullName}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="270" y="0" width="120" height="20"/>
                <textElement verticalAlignment="Middle">
                    <font size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{email}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="400" y="0" width="60" height="20"/>
                <textElement verticalAlignment="Middle">
                    <font size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{role}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="470" y="0" width="60" height="20"/>
                <textElement verticalAlignment="Middle">
                    <font size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{status}]]></textFieldExpression>
            </textField>
        </band>
    </detail>
</jasperReport>