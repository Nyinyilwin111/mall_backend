<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="branch_list_report"
              pageWidth="595"
              pageHeight="842"
              columnWidth="555"
              leftMargin="20"
              rightMargin="20"
              topMargin="20"
              bottomMargin="20"
              uuid="c88cced1-8d52-4eae-9371-fdb351092276">

    <property name="com.jaspersoft.studio.data.defaultdataadapter" value="One Empty Record"/>
    <property name="com.jasperassistant.designer.GridHeight" value="60"/>
    <property name="com.jasperassistant.designer.GridWidth" value="60"/>

    <!-- Parameters -->
    <parameter name="REPORT_TITLE" class="java.lang.String" isForPrompting="false">
        <defaultValueExpression><![CDATA["BRANCH MANAGEMENT REPORT"]]></defaultValueExpression>
    </parameter>
    <parameter name="COMPANY_NAME" class="java.lang.String" isForPrompting="false">
        <defaultValueExpression><![CDATA["SEIN GAY HAR"]]></defaultValueExpression>
    </parameter>
    <parameter name="COMPANY_LOGO" class="java.io.InputStream" isForPrompting="false"/>
    <parameter name="REPORT_DATE" class="java.util.Date" isForPrompting="false">
        <defaultValueExpression><![CDATA[new java.util.Date()]]></defaultValueExpression>
    </parameter>
    <parameter name="GENERATED_BY" class="java.lang.String" isForPrompting="false">
        <defaultValueExpression><![CDATA["System Administrator"]]></defaultValueExpression>
    </parameter>
    <parameter name="REPORT_ID" class="java.lang.String" isForPrompting="false">
        <defaultValueExpression><![CDATA["BRANCH-LIST-2025"]]></defaultValueExpression>
    </parameter>
    <parameter name="TOTAL_BRANCHES" class="java.lang.Integer"/>
    <parameter name="GENERATED_DATE" class="java.util.Date"/>
    <parameter name="LOGO_IMAGE" class="java.lang.String"/>

    <!-- Fields -->
    <field name="id" class="java.lang.Long"/>
    <field name="name" class="java.lang.String"/>
    <field name="address" class="java.lang.String"/>
    <field name="phoneNumber" class="java.lang.String"/>
    <field name="createdAt" class="java.time.LocalDateTime"/>
    <field name="updatedAt" class="java.time.LocalDateTime"/>
    <field name="userCount" class="java.lang.Integer"/>

    <title>
        <band height="130" splitType="Stretch">
            <!-- Header Background -->
            <rectangle radius="8">
                <reportElement x="0" y="0" width="555" height="110" backcolor="#2C3E50"/>
                <graphicElement>
                    <pen lineWidth="0.0" lineColor="#2C3E50"/>
                </graphicElement>
            </rectangle>

            <!-- Logo -->
            <image scaleImage="RetainShape" onErrorType="Blank">
                <reportElement x="20" y="20" width="70" height="70"/>
                <imageExpression><![CDATA["classpath:image/SGH-logo.png"]]></imageExpression>
            </image>

            <!-- Company Name -->
            <textField isBlankWhenNull="true">
                <reportElement x="105" y="25" width="300" height="30" forecolor="#FFFFFF"/>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="18" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{COMPANY_NAME}]]></textFieldExpression>
            </textField>

            <!-- Report Title -->
            <textField isBlankWhenNull="true">
                <reportElement x="105" y="55" width="300" height="25" forecolor="#ECF0F1"/>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="14" isBold="false"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{REPORT_TITLE}]]></textFieldExpression>
            </textField>

            <!-- Report Type Badge -->
            <textField isBlankWhenNull="true">
                <reportElement x="105" y="80" width="120" height="20" forecolor="#2C3E50" backcolor="#ECF0F1"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["BRANCH MANAGEMENT"]]></textFieldExpression>
            </textField>

            <!-- Date -->
            <textField pattern="EEEE, MMMM dd, yyyy">
                <reportElement x="353" y="25" width="190" height="20" forecolor="#ECF0F1"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="11" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{REPORT_DATE}]]></textFieldExpression>
            </textField>

            <!-- Generated by -->
            <textField isBlankWhenNull="true">
                <reportElement x="353" y="50" width="190" height="18" forecolor="#BDC3C7"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="10"/>
                </textElement>
                <textFieldExpression><![CDATA["Generated by: " + $P{GENERATED_BY}]]></textFieldExpression>
            </textField>

            <!-- Version info -->
            <textField isBlankWhenNull="true">
                <reportElement x="353" y="73" width="190" height="15" forecolor="#95A5A6"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["v1.0 | " + $P{REPORT_ID}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <!-- Column Header -->
    <columnHeader>
        <band height="40" splitType="Stretch">
            <!-- Table Header Background -->
            <rectangle radius="5">
                <reportElement x="0" y="0" width="555" height="35" backcolor="#34495E"/>
                <graphicElement>
                    <pen lineWidth="0.0" lineColor="#34495E"/>
                </graphicElement>
            </rectangle>

            <!-- Column Headers -->
            <staticText>
                <reportElement x="10" y="8" width="40" height="20" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[ID]]></text>
            </staticText>

            <staticText>
                <reportElement x="60" y="8" width="120" height="20" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[Branch Name]]></text>
            </staticText>

            <staticText>
                <reportElement x="190" y="8" width="180" height="20" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[Address]]></text>
            </staticText>

            <staticText>
                <reportElement x="380" y="8" width="80" height="20" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[Phone]]></text>
            </staticText>

            <staticText>
                <reportElement x="470" y="8" width="70" height="20" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[Created Date]]></text>
            </staticText>
        </band>
    </columnHeader>

    <!-- Detail -->
    <detail>
        <band height="45" splitType="Stretch">
            <!-- Alternating row background -->
            <rectangle>
                <reportElement x="0" y="0" width="555" height="35" mode="Opaque" backcolor="#F8F9FA">
                    <printWhenExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></printWhenExpression>
                </reportElement>
                <graphicElement>
                    <pen lineWidth="0.0" lineColor="#F8F9FA"/>
                </graphicElement>
            </rectangle>

            <!-- ID -->
            <textField isBlankWhenNull="true">
                <reportElement x="10" y="8" width="40" height="20"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="10"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{id}]]></textFieldExpression>
            </textField>

            <!-- Branch Name -->
            <textField isBlankWhenNull="true">
                <reportElement x="60" y="8" width="120" height="20"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{name}]]></textFieldExpression>
            </textField>

            <!-- Address -->
            <textField isBlankWhenNull="true">
                <reportElement x="190" y="8" width="180" height="35"/>
                <textElement verticalAlignment="Top">
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{address}]]></textFieldExpression>
            </textField>

            <!-- Phone -->
            <textField isBlankWhenNull="true">
                <reportElement x="380" y="8" width="80" height="20"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{phoneNumber}]]></textFieldExpression>
            </textField>

            <!-- Created Date -->
            <textField isBlankWhenNull="true">
                <reportElement x="470" y="8" width="70" height="20"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[
                    $F{createdAt} != null ?
                    $F{createdAt}.format(java.time.format.DateTimeFormatter.ofPattern("yyyy-MM-dd")) :
                    "N/A"
                ]]></textFieldExpression>
            </textField>

            <!-- Bottom border -->
            <line>
                <reportElement x="0" y="34" width="555" height="1"/>
                <graphicElement>
                    <pen lineWidth="0.5" lineColor="#E9ECEF"/>
                </graphicElement>
            </line>
        </band>
    </detail>

    <!-- Column Footer -->
    <columnFooter>
        <band height="30" splitType="Stretch">
            <line>
                <reportElement x="0" y="0" width="555" height="1"/>
                <graphicElement>
                    <pen lineWidth="1.0" lineColor="#2C3E50"/>
                </graphicElement>
            </line>
        </band>
    </columnFooter>

    <!-- Page Footer -->
    <pageFooter>
        <band height="50" splitType="Stretch">
            <!-- Confidential watermark -->
            <textField>
                <reportElement x="0" y="0" width="555" height="15" forecolor="#D1D5DB"/>
                <textElement textAlignment="Center">
                    <font fontName="DejaVu Sans" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["CONFIDENTIAL - For Internal Use Only"]]></textFieldExpression>
            </textField>

            <!-- Page counter -->
            <textField>
                <reportElement x="0" y="20" width="275" height="20"/>
                <textElement textAlignment="Left">
                    <font fontName="DejaVu Sans" size="9" isItalic="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Generated on " + new java.util.Date()]]></textFieldExpression>
            </textField>

            <!-- Page number -->
            <textField evaluationTime="Report">
                <reportElement x="280" y="20" width="275" height="20"/>
                <textElement textAlignment="Right">
                    <font fontName="DejaVu Sans" size="9" isItalic="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER} + " of " + $V{PAGE_COUNT}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <!-- Summary -->
    <summary>
        <band height="60" splitType="Stretch">
            <!-- Summary Background -->
            <rectangle radius="5">
                <reportElement x="0" y="0" width="555" height="50" backcolor="#2C3E50"/>
                <graphicElement>
                    <pen lineWidth="0.0" lineColor="#2C3E50"/>
                </graphicElement>
            </rectangle>

            <!-- Total Branches -->
            <textField evaluationTime="Report">
                <reportElement x="20" y="15" width="200" height="20" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="11" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Total Branches: " + $V{REPORT_COUNT}]]></textFieldExpression>
            </textField>

            <!-- Total Users -->
<!--            <textField evaluationTime="Report">-->
<!--                <reportElement x="250" y="15" width="150" height="20" forecolor="#BDC3C7"/>-->
<!--                <textElement verticalAlignment="Middle">-->
<!--                    <font fontName="DejaVu Sans" size="10"/>-->
<!--                </textElement>-->
<!--                <textFieldExpression><![CDATA["Total Users: " + $F{userCount}]]></textFieldExpression>-->
<!--            </textField>-->

            <!-- Report Generation Time -->
            <textField pattern="HH:mm:ss">
                <reportElement x="420" y="15" width="115" height="20" forecolor="#BDC3C7"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="10"/>
                </textElement>
                <textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression>
            </textField>
        </band>
    </summary>
</jasperReport>