        <defaultValueExpression><![CDATA[new java.util.Date()]]></defaultValueExpression>
    </parameter>

    <!-- Query String -->
    <queryString>
        <![CDATA[
        SELECT
            p.payment_id,
            p.amount,
            p.payment_date,
            p.status,
            COALESCE(b.name, 'No Branch') as branch_name,
            s.space_code,
            CASE
                WHEN p.lease_id IS NOT NULL THEN 'LEASE'
                WHEN p.utility_id IS NOT NULL THEN 'UTILITY'
                ELSE 'OTHER'
            END as payment_type
        FROM payment p
        LEFT JOIN lease l ON p.lease_id = l.lease_id
        LEFT JOIN utility u ON p.utility_id = u.utility_id
        LEFT JOIN space s ON l.space_id = s.space_id OR u.space_id = s.space_id
        LEFT JOIN floor f ON s.Floor_floor_id = f.floor_id
        LEFT JOIN branches b ON f.branch_branch_id = b.id
        WHERE p.status IN ('PAID', 'VERIFIED')
        AND p.payment_date BETWEEN $P{startDate} AND $P{endDate}
        AND ($P{branchId} IS NULL OR b.id = $P{branchId})
        ORDER BY p.payment_date, b.name
        ]]>
    </queryString>

    <!-- Fields -->
    <field name="payment_id" class="java.lang.Long"/>
    <field name="amount" class="java.math.BigDecimal"/>
    <field name="payment_date" class="java.sql.Date"/>
    <field name="status" class="java.lang.String"/>
    <field name="branch_name" class="java.lang.String"/>
    <field name="space_code" class="java.lang.String"/>
    <field name="payment_type" class="java.lang.String"/>

    <!-- Variables -->
