<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="branch_analytics_report"
              pageWidth="595"
              pageHeight="842"
              columnWidth="555"
              leftMargin="20"
              rightMargin="20"
              topMargin="20"
              bottomMargin="20">

    <property name="com.jaspersoft.studio.data.defaultdataadapter" value="One Empty Record"/>

    <!-- Parameters -->
    <parameter name="REPORT_TITLE" class="java.lang.String" isForPrompting="false">
        <defaultValueExpression><![CDATA["BRANCH ANALYTICS REPORT"]]></defaultValueExpression>
    </parameter>
    <parameter name="COMPANY_NAME" class="java.lang.String" isForPrompting="false">
        <defaultValueExpression><![CDATA["Sein Gar Har Real Estate"]]></defaultValueExpression>
    </parameter>
    <parameter name="COMPANY_LOGO" class="java.io.InputStream" isForPrompting="false"/>
    <parameter name="REPORT_DATE" class="java.util.Date" isForPrompting="false">
        <defaultValueExpression><![CDATA[new java.util.Date()]]></defaultValueExpression>
    </parameter>
    <parameter name="GENERATED_BY" class="java.lang.String" isForPrompting="false">
        <defaultValueExpression><![CDATA["System Administrator"]]></defaultValueExpression>
    </parameter>
    <parameter name="REPORT_ID" class="java.lang.String" isForPrompting="false">
        <defaultValueExpression><![CDATA["BRANCH-ANALYTICS-2025"]]></defaultValueExpression>
    </parameter>
    <parameter name="TOTAL_BRANCHES" class="java.lang.Long"/>
    <parameter name="TOTAL_USERS" class="java.lang.Long"/>
    <parameter name="AVERAGE_USERS_PER_BRANCH" class="java.lang.String"/>
    <parameter name="GENERATED_DATE" class="java.util.Date"/>
    <parameter name="REPORT_PERIOD" class="java.lang.String"/>

    <!-- Fields -->
    <field name="branchName" class="java.lang.String"/>
    <field name="userCount" class="java.lang.Integer"/>
    <field name="address" class="java.lang.String"/>
    <field name="phone" class="java.lang.String"/>
    <field name="createdDate" class="java.time.LocalDateTime"/>

    <!-- Variables -->
    <variable name="TotalUsers" class="java.lang.Integer" calculation="Sum">
        <variableExpression><![CDATA[$F{userCount}]]></variableExpression>
    </variable>

    <variable name="MaxUsers" class="java.lang.Integer" calculation="Highest">
        <variableExpression><![CDATA[$F{userCount}]]></variableExpression>
    </variable>

    <variable name="MinUsers" class="java.lang.Integer" calculation="Lowest">
        <variableExpression><![CDATA[$F{userCount}]]></variableExpression>
    </variable>

    <!-- Background -->
    <background>
        <band height="0" splitType="Stretch"/>
    </background>

    <!-- Title -->
    <title>
        <band height="130" splitType="Stretch">
            <!-- Header Background -->
            <rectangle radius="8">
                <reportElement x="0" y="0" width="555" height="110" backcolor="#2C3E50"/>
                <graphicElement>
                    <pen lineWidth="0.0" lineColor="#2C3E50"/>
                </graphicElement>
            </rectangle>

            <!-- Logo -->
            <image scaleImage="RetainShape" onErrorType="Blank">
                <reportElement x="20" y="20" width="70" height="70"/>
                <imageExpression><![CDATA["classpath:image/SGH-logo.png"]]></imageExpression>
            </image>

            <!-- Company Name -->
            <textField isBlankWhenNull="true">
                <reportElement x="105" y="25" width="300" height="30" forecolor="#FFFFFF"/>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="18" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{COMPANY_NAME}]]></textFieldExpression>
            </textField>

            <!-- Report Title -->
            <textField isBlankWhenNull="true">
                <reportElement x="105" y="55" width="300" height="25" forecolor="#ECF0F1"/>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="14" isBold="false"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{REPORT_TITLE}]]></textFieldExpression>
            </textField>

            <!-- Report Type Badge -->
            <textField isBlankWhenNull="true">
                <reportElement x="105" y="80" width="120" height="20" forecolor="#2C3E50" backcolor="#ECF0F1"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["ANALYTICS"]]></textFieldExpression>
            </textField>

            <!-- Date -->
            <textField pattern="EEEE, MMMM dd, yyyy">
                <reportElement x="353" y="25" width="190" height="20" forecolor="#ECF0F1"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="11" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{REPORT_DATE}]]></textFieldExpression>
            </textField>

            <!-- Generated by -->
            <textField isBlankWhenNull="true">
                <reportElement x="353" y="50" width="190" height="18" forecolor="#BDC3C7"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="10"/>
                </textElement>
                <textFieldExpression><![CDATA["Generated by: " + $P{GENERATED_BY}]]></textFieldExpression>
            </textField>

            <!-- Version info -->
            <textField isBlankWhenNull="true">
                <reportElement x="353" y="73" width="190" height="15" forecolor="#95A5A6"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["v1.0 | " + $P{REPORT_ID}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <!-- Page Header -->
    <pageHeader>
        <band height="0" splitType="Stretch"/>
    </pageHeader>

    <!-- Column Header -->
    <columnHeader>
        <band height="40" splitType="Stretch">
            <!-- Table Header Background -->
            <rectangle radius="5">
                <reportElement x="0" y="0" width="555" height="35" backcolor="#34495E"/>
                <graphicElement>
                    <pen lineWidth="0.0" lineColor="#34495E"/>
                </graphicElement>
            </rectangle>

            <!-- Column Headers -->
            <staticText>
                <reportElement x="10" y="8" width="150" height="20" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[Branch Name]]></text>
            </staticText>

            <staticText>
                <reportElement x="170" y="8" width="80" height="20" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[Users]]></text>
            </staticText>

            <staticText>
                <reportElement x="260" y="8" width="180" height="20" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[Address]]></text>
            </staticText>

            <staticText>
                <reportElement x="450" y="8" width="60" height="20" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[Phone]]></text>
            </staticText>
        </band>
    </columnHeader>

    <!-- Detail -->
    <detail>
        <band height="45" splitType="Stretch">
            <!-- Alternating row background -->
            <rectangle>
                <reportElement x="0" y="0" width="555" height="35" mode="Opaque" backcolor="#F8F9FA">
                    <printWhenExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></printWhenExpression>
                </reportElement>
                <graphicElement>
                    <pen lineWidth="0.0" lineColor="#F8F9FA"/>
                </graphicElement>
            </rectangle>

            <!-- Branch Name -->
            <textField isBlankWhenNull="true">
                <reportElement x="10" y="5" width="150" height="25"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{branchName}]]></textFieldExpression>
            </textField>

            <!-- User Count -->
            <textField isBlankWhenNull="true">
                <reportElement x="170" y="5" width="80" height="25"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="10"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{userCount}]]></textFieldExpression>
            </textField>

            <!-- Address -->
            <textField isBlankWhenNull="true">
                <reportElement x="260" y="5" width="180" height="35"/>
                <textElement verticalAlignment="Top">
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{address}]]></textFieldExpression>
            </textField>

            <!-- Phone -->
            <textField isBlankWhenNull="true">
                <reportElement x="450" y="5" width="60" height="25"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{phone}]]></textFieldExpression>
            </textField>

            <!-- Bottom border -->
            <line>
                <reportElement x="0" y="34" width="555" height="1"/>
                <graphicElement>
                    <pen lineWidth="0.5" lineColor="#E9ECEF"/>
                </graphicElement>
            </line>
        </band>
    </detail>

    <!-- Column Footer -->
    <columnFooter>
        <band height="0" splitType="Stretch"/>
    </columnFooter>

    <!-- Page Footer -->
    <pageFooter>
        <band height="50" splitType="Stretch">
            <!-- Confidential watermark -->
            <textField>
                <reportElement x="0" y="0" width="555" height="15" forecolor="#D1D5DB"/>
                <textElement textAlignment="Center">
                    <font fontName="DejaVu Sans" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["CONFIDENTIAL - For Internal Use Only"]]></textFieldExpression>
            </textField>

            <!-- Page counter -->
            <textField>
                <reportElement x="0" y="20" width="275" height="20"/>
                <textElement textAlignment="Left">
                    <font fontName="DejaVu Sans" size="9" isItalic="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Generated on " + new java.util.Date()]]></textFieldExpression>
            </textField>

            <!-- Page number -->
            <textField evaluationTime="Report">
                <reportElement x="280" y="20" width="275" height="20"/>
                <textElement textAlignment="Right">
                    <font fontName="DejaVu Sans" size="9" isItalic="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER} + " of " + $V{PAGE_COUNT}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <!-- Last Page Footer -->
    <lastPageFooter>
        <band height="0" splitType="Stretch"/>
    </lastPageFooter>

    <!-- Summary -->
    <summary>
        <band height="100" splitType="Stretch">
            <!-- Stats Background -->
            <rectangle radius="5">
                <reportElement x="0" y="0" width="555" height="90" backcolor="#F8F9FA"/>
                <graphicElement>
                    <pen lineWidth="1.0" lineColor="#DEE2E6"/>
                </graphicElement>
            </rectangle>

            <!-- Stats Title -->
            <staticText>
                <reportElement x="20" y="10" width="200" height="20" forecolor="#2C3E50"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="12" isBold="true"/>
                </textElement>
                <text><![CDATA[Key Performance Indicators]]></text>
            </staticText>

            <!-- Total Branches -->
            <staticText>
                <reportElement x="30" y="40" width="120" height="15" forecolor="#6C757D"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Total Branches:]]></text>
            </staticText>
            <textField>
                <reportElement x="150" y="40" width="50" height="15" forecolor="#2C3E50"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{TOTAL_BRANCHES}]]></textFieldExpression>
            </textField>

            <!-- Total Users -->
            <staticText>
                <reportElement x="220" y="40" width="100" height="15" forecolor="#6C757D"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Total Users:]]></text>
            </staticText>
            <textField>
                <reportElement x="320" y="40" width="50" height="15" forecolor="#2C3E50"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{TOTAL_USERS}]]></textFieldExpression>
            </textField>

            <!-- Average Users -->
            <staticText>
                <reportElement x="390" y="40" width="140" height="15" forecolor="#6C757D"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Avg Users/Branch:]]></text>
            </staticText>
            <textField>
                <reportElement x="530" y="40" width="15" height="15" forecolor="#2C3E50"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{AVERAGE_USERS_PER_BRANCH}]]></textFieldExpression>
            </textField>

            <!-- Report Period -->
            <staticText>
                <reportElement x="30" y="65" width="100" height="15" forecolor="#6C757D"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Report Period:]]></text>
            </staticText>
            <textField>
                <reportElement x="130" y="65" width="200" height="15" forecolor="#2C3E50"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{REPORT_PERIOD}]]></textFieldExpression>
            </textField>
        </band>
    </summary>

    <!-- No Data -->
    <noData>
        <band height="100" splitType="Stretch">
            <textField>
                <reportElement x="0" y="0" width="555" height="100" forecolor="#999999"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="14" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["No branch data available for the selected criteria"]]></textFieldExpression>
            </textField>
        </band>
    </noData>
</jasperReport>